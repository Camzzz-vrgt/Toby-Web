global.loc_embedded = json_parse("{\"chapter_select_play\":{\"en\":\"Play\",\"ja\":\"プレイする\"},\"chapter_select_donot\":{\"en\":\"Do Not\",\"ja\":\"もどる\"},\"chapter_select_lanswitch\":{\"en\":\"日本語\",\"ja\":\"English\"},\"chapter_select_quit\":{\"en\":\"Quit\",\"ja\":\"終了\"},\"chapter_select_start_0\":{\"en\":\"Would you like to start from Chapter {0}?\",\"ja\":\"Chapter {0}から始めますか？\"},\"chapter_select_start_1\":{\"en\":\"Continue from Chapter {0}?\",\"ja\":\"Chapter {0}から続けますか？\"},\"chapter_select_start_2\":{\"en\":\"Chapter {0} was completed.\",\"ja\":\"Chapter {0}はクリア済みです。\"},\"chapter_select_start_2_yes\":{\"en\":\"Play Chapter {0}\",\"ja\":\"Chapter {0}をプレイ\"},\"chapter_select_start_2_no\":{\"en\":\"Credits\",\"ja\":\"チャプター選択\"},\"chapter_select_yes\":{\"en\":\"Yes\",\"ja\":\"はい\"},\"chapter_select_no\":{\"en\":\"No\",\"ja\":\"いいえ\"},\"chapter_1\":{\"en\":\"The Beginning\",\"ja\":\"はじまり\"},\"chapter_2\":{\"en\":\"A Cyber's World\",\"ja\":\"サイバーワールド\"},\"chapter_3\":{\"en\":\"Late Night\",\"ja\":\"レイトナイト\"},\"chapter_4\":{\"en\":\"Prophecy\",\"ja\":\"予言\"},\"enc_ui_spr_buttons\":{\"en\":\"spr_ui_enc_bt_{0}\",\"ja\":\"spr_ui_enc_bt_{0}_ja\"},\"enc_ui_label_hp\":{\"en\":\"HP\",\"ja\":\"HP\"},\"enc_ui_label_mercy\":{\"en\":\"MERCY\",\"ja\":\"みのがす\"},\"enc_ui_label_standard\":{\"en\":\"Standard\",\"ja\":\"NORMAL\"},\"enc_win\":{\"en\":\"* You won!{br}{resetx}* Got {0} EXP and {1} D$.\",\"ja\":\"＊ YOU WIN！{br}{resetx}＊ {0} EXPと　{1} D$を獲得！\"},\"enc_win_msg_susieheal\":{\"en\":\"* Susie's heal power increased!\",\"ja\":\"* Susie's heal power increased!\"},\"enc_win_msg_stronger\":{\"en\":\"* You became stronger.\",\"ja\":\"＊ 強くなった。\"},\"enc_act_check\":{\"en\":\"Check\",\"ja\":\"ぶんせき\"},\"enc_exec_spare_msg\":{\"en\":\"* {0} spared {1}!\",\"ja\":\"＊ {0}は　{1}を{br}にがした！\"},\"enc_exec_spare_notyellow\":{\"en\":\"* But its name wasn't {col(y)}YELLOW{col(w)}...\",\"ja\":\"＊ しかし名前が　{col(y)}きいろ{col(w)}くない…\"},\"enc_exec_spare_suggest_spell\":{\"en\":\"* (Try using {0}'s {col(y)}{1}{col(w)}!)\",\"ja\":\"＊ ({0}に　{col(y)}{1}{col(w)}を{br}唱えさせてみよう！)\"},\"enemy_virovirokun_name\":{\"en\":\"Virovirokun\",\"ja\":\"ウィルスン\"},\"enemy_virovirokun_act_check\":{\"en\":\"* VIROVIROKUN - This sick virus needs affordable healthcare.\",\"ja\":\"＊ ウィルスン - 病気のウィルス。　お手ごろ価格の　医療を受けたい。\"},\"enemy_virovirokun_act_takecare\":{\"en\":\"TakeCare\",\"ja\":\"ケア\"},\"enemy_virovirokun_act_takecare_msg\":{\"en\":\"* You treated Virovirokun with care! It's no longer infectious!\",\"ja\":\"＊ ウィルスンを　やさしくケアした！　ウィルスンは　もう感染しない！\"},\"enemy_virovirokun_act_takecarex\":{\"en\":\"TakeCareX\",\"ja\":\"ケアＸ\"},\"enemy_virovirokun_act_takecarex_msg\":{\"en\":\"* Everyone treated the enemy with tender loving care!! All the enemies felt great!!\",\"ja\":\"＊ みんな　敵を　やさしくケアした！{br}敵は　すっかり元気になった！！\"},\"enemy_virovirokun_act_susie\":{\"en\":[\"* Susie commiserated with the enemy!\",\"{char(susie, 2)}* Stick it to the man, dude.\",\"* Even if that means cloning yourself, or, whatever.\"],\"ja\":[\"＊ スージィは　敵に同情した！\",\"{char(susie, 2)}＊ ケンリョクなんかに　負けんなよ。\",\"＊ 自分のクローンを　作ってでも　出し抜いてやれよな。\"]},\"enemy_virovirokun_act_ralsei\":{\"en\":[\"* Ralsei tried to steer the enemy down the right path.\",\"{char(ralsei, 3)}* Not everybody knows this, but...\",\"{f_ex(2)}* Crimes are bad. ... Did you know that?\"],\"ja\":[\"＊ ラルセイは　敵を正しい道へ導こうとした。\",\"{char(ralsei, 3)}＊ 知らないひとも　多いと思うけど…\",\"{f_ex(2)}＊ じつは　犯罪って　悪いことなんですよ…　知ってましたか？\"]},\"enemy_virovirokun_act_noelle\":{\"en\":\"* Noelle offered a cold compress!\",\"ja\":\"＊ ノエルは　湿布を差し出した！\"},\"enemy_virovirokun_dialogue\":{\"en\":[\"I'm the fever, I'm the chill.\",\"Don't let this bug ya!\",\"Happy new year 1997!\",\"I've got a love letter for you.\",\"Got your nose!\"],\"ja\":[\"ボクはFEVER ボクはCHILL\",\"ボク “悪気”も “寒気”も ないんだけどな\",\"Happy new year 1997!\",\"キミに贈るよ I Love You\",\"Got your nose!\"]},\"enemy_virovirokun_mercy\":{\"en\":[\"Just what the doctor ordered!\",\"Kindness is contagious!\"],\"ja\":[\"お医者さんの 言うとおり！\",\"やさしさを 拡散！\"]},\"enemy_virovirokun_recruit\":{\"en\":{\"name\":\"Virovirokun\",\"desc\":\"A virus with a slightly criminal streak... and a heart of gold.\",\"element\":\"VIRUS\",\"like\":\"Retro Games\",\"dislike\":\"Federal Justice System\"},\"ja\":{\"name\":\"ウィルスン\",\"desc\":\"ついつい犯罪に走りがち…\\nだけど根はいいヤツ。\",\"element\":\"病\",\"like\":\"レトロゲーム\",\"dislike\":\"司法制度\"}},\"ex_spell_revivekris\":{\"en\":\"ReviveKris\",\"ja\":\"\"},\"ex_spell_revivekris_desc\":{\"en\":\"Revive\\nKris\",\"ja\":\"\"},\"font_main\":{\"en\":\"font_main\",\"ja\":\"font_main_ja\"},\"font_text\":{\"en\":\"font_main_mono\",\"ja\":\"font_main_ja\"},\"font_enc\":{\"en\":\"font_dotumche\",\"ja\":\"font_dotumche_ja\"},\"font_name\":{\"en\":[\"spr_ui_partyname_font\",\"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz1234567890/\"],\"ja\":[\"spr_ui_partyname_font_ja\",\"アイウエオカキクケコサシスセソタチツテトナニヌネノハヒフヘホマミムメモヤユヨラリルレロワヲンァィゥェォャュョッヮーヴガギグゲゴザジズゼゾダヂヅデドバビブベボパピプペポABCDEFGHIJKLMNOPQRSTUVWXYZ\"]},\"font_prophecy\":{\"en\":\"font_prophecy\",\"ja\":\"font_prophecy_ja\"},\"game_over_continue\":{\"en\":\"CONTINUE\",\"ja\":\"CONTINUE\"},\"game_over_give_up\":{\"en\":\"GIVE UP\",\"ja\":\"GIVE UP\"},\"game_over_dialogue_susie\":{\"en\":[\"{voice(snd_text_susie)}Come on,{br}that all you got!?\",\"Kris,{br}get up...!\"],\"ja\":[\"{voice(snd_text_susie)}クリス{br}しっかりしろよ！\",\"まだ終われねーだろ？{br}起きろって…！\"]},\"game_over_dialogue_ralsei\":{\"en\":[\"{voice(snd_text_ralsei)}This is not{br}your fate...!\",\"Please,{br}don't give up!\"],\"ja\":[\"{voice(snd_text_ralsei)}キミは こんなところで{br}終わるはずじゃない…！\",\"あきらめちゃ{br}ダメだよ！\"]},\"game_over_dialogue_give_up\":{\"en\":\"THEN THE WORLD{br}{s(20)}WAS COVERED{br}{s(20)}IN DARKNESS.\",\"ja\":\"世界ハ{br}{s(20)}闇ニ　包マレマシタ。\"},\"item_use\":{\"en\":\"* {0} used {1}!\",\"ja\":\"＊ {0}は{1}を発動した！\"},\"item_added\":{\"en\":\"* ({col(y)}{0}{col(w)} was added to your {col(y)}{1}{col(w)}.)\",\"ja\":\"＊ ({col(y)}{0}{col(w)}が{br}{col(y)}{1}{col(w)}に　加わった)\"},\"item_added_no_space\":{\"en\":\"* (You didn't have enough space.)\",\"ja\":\"＊ (もちものが　いっぱいだった)\"},\"item_type_items\":{\"en\":\"ITEMs\",\"ja\":\"アイテム\"},\"item_type_key_items\":{\"en\":\"KEY ITEMs\",\"ja\":\"だいじなもの\"},\"item_type_weapons\":{\"en\":\"WEAPONS\",\"ja\":\"ぶき\"},\"item_type_armors\":{\"en\":\"ARMORS\",\"ja\":\"ぼうぐ\"},\"item_type_storage\":{\"en\":\"STORAGE\",\"ja\":\"そうこ\"},\"item_chest_get\":{\"en\":\"* (You opened the treasure chest.){s(10)}{br}{resetx}* (Inside was {col(y)}{0}{col(w)}.)\",\"ja\":\"＊ (宝箱を開けた){s(10)}{br}{resetx}＊ ({col(y)}{0}{col(w)}が{br}　 入っていた)\"},\"item_chest_empty\":{\"en\":\"* (The chest is empty.)\",\"ja\":\"＊ (宝箱は　からっぽだ)\"},\"item_susie_comment\":{\"en\":\"Hey, hands off!\",\"ja\":\"さわんなよ！\"},\"item_a_amber_card\":{\"en\":{\"name\":\"Amber Card\",\"desc\":[\"A thin square charm that sticks to you, increasing defense.\",\"--\"],\"reactions\":{\"susie\":\"... better than nothing.\",\"ralsei\":\"It's sticky, huh, Kris...\",\"noelle\":\"It's like a name-tag!\"}},\"ja\":{\"name\":\"アンバーカード\",\"desc\":[\"うすっぺらい正方形の護符。\\n体に張りつけ ぼうぎょ力を上げる。\",\"--\"],\"reactions\":{\"susie\":\"…ま ないよりマシだな。\",\"ralsei\":\"クリス…なんかベタベタするよ…\",\"noelle\":\"名札みたい！\"}}},\"item_a_silver_card\":{\"en\":{\"name\":\"Silver Card\",\"desc\":[\"A square charm that increases\\ndropped money by 5%\",\"--\"],\"reactions\":{\"susie\":\"Money, that's what I need.\",\"ralsei\":\"Do they take credit?\",\"noelle\":\"It goes with my watch!\"}},\"ja\":{\"name\":\"シルバーカード\",\"desc\":[\"バトル後に手に入るおカネが５％増える。\",\"--\"],\"reactions\":{\"susie\":\"カネ オレの ほしいもの\",\"ralsei\":\"カードで お買い物できる？\",\"noelle\":\"わたしの うで時計と同じ色！\"}}},\"item_a_pink_ribbon\":{\"en\":{\"name\":\"Pink Ribbon\",\"desc\":[\"A cute hair ribbon. Increases the range at which bullets raise tension.\",\"--\"],\"effect\":{\"text\":\"GrazeArea\"},\"reactions\":{\"susie\":\"Nope. Not in 1st grade anymore.\",\"ralsei\":\"Um... D-do I look cute...?\",\"noelle\":\"... feels familiar.\"}},\"ja\":{\"name\":\"ピンクリボン\",\"desc\":[\"頭につける かわいいリボン。弾をギリギリ\\nよけたときにTPがたまる範囲が広くなる。\",\"--\"],\"effect\":{\"text\":\"かすりエリア\"},\"reactions\":{\"susie\":\"はぁ？小学生じゃねーっつの\",\"ralsei\":\"ど…どう？ かわいいかな…？\",\"noelle\":\"…見覚えがあるような\"}}},\"item_a_white_ribbon\":{\"en\":{\"name\":\"White Ribbon\",\"desc\":[\"A crinkly hair ribbon that slightly\\nincreases your defense.\",\"--\"],\"effect\":{\"text\":\"Cuteness\"},\"reactions\":{\"susie\":\"Nope. Not in 1st grade anymore.\",\"ralsei\":\"Um... D-do I look cute...?\",\"noelle\":\"... feels familiar.\"}},\"ja\":{\"name\":\"ホワイトリボン\",\"desc\":[\"髪にかざる シワシワのリボン。\\nぼうぎょ力が 少し上がる。\",\"--\"],\"effect\":{\"text\":\"かわいさ\"},\"reactions\":{\"susie\":\"はぁ？小学生じゃねーっつの\",\"ralsei\":\"ど…どう？ かわいいかな…？\",\"noelle\":\"…見覚えがあるような\"}}},\"item_a_twin_ribbon\":{\"en\":{\"name\":\"Twin Ribbon\",\"desc\":[\"Two ribbons. You'll have to put\\nyour hair into pigtails.\",\"--\"],\"effect\":{\"text\":\"GrazeArea\"},\"reactions\":{\"susie\":\"... it gets worse and worse.\",\"ralsei\":\"Try around my horns!\",\"noelle\":\"... nostalgic, huh.\"}},\"ja\":{\"name\":\"ツインリボン\",\"desc\":[\"２本のリボン。髪型をツインテールにしないと\\n装備できない。\",\"--\"],\"effect\":{\"text\":\"かすりエリア\"},\"reactions\":{\"susie\":\"…マジでカンベンしてくれ\",\"ralsei\":\"ツノに巻くね！\",\"noelle\":\"…なつかしいな\"}}},\"item_a_royal_pin\":{\"en\":{\"name\":\"Royal Pin\",\"desc\":[\"A brooch engraved with Queen's face. Careful of the sharp point.\",\"--\"],\"reactions\":{\"susie\":\"ROACH? Oh, brooch. Heh.\",\"ralsei\":\"I'm a cute little corkboard!\",\"noelle\":\"Queen... gave this to me.\"}},\"ja\":{\"name\":\"王族のブローチ\",\"desc\":[\"クイーンの顔が刻まれたブローチ。\\nするどい針に気をつけて。\",\"--\"],\"reactions\":{\"susie\":\"ブローチってなんだ？ うまいのか？\",\"ralsei\":\"カワイイ掲示板になった気分！\",\"noelle\":\"クイーンからもらったの…\"}}},\"item_a_silver_watch\":{\"en\":{\"name\":\"Silver Watch\",\"desc\":[\"Grazing bullets affects the turn length by 10% more\",\"--\"],\"effect\":{\"text\":\"GrazeTime\"},\"reactions\":{\"susie\":\"It's clobbering time.\",\"ralsei\":\"I'm late, I'm late!\",\"noelle\":\"(Th-this was mine...)\"}},\"ja\":{\"name\":\"銀のうで時計\",\"desc\":[\"バトルで弾をギリギリよけると\\n敵ターンの長さが短くなる(効果10％+)。\",\"--\"],\"effect\":{\"text\":\"かすりタイム\"},\"reactions\":{\"susie\":\"「おしおきの“時間”だぜ」\",\"ralsei\":\"「遅刻だ 遅刻～！」\",\"noelle\":\"(こ…これ… わたしの…)\"}}},\"item_a_wristwatch\":{\"en\":{\"name\":\"Wristwatch\",\"desc\":[\"* \\\"Wristwatch\\\" - Armor 1 DF{br}{resetx}{sleep(10)}* Maybe an expensive antique.{br}{resetx}{sleep(10)}* Stuck before half past noon.\",\"--\"]},\"ja\":{\"name\":\"うでどけい\",\"desc\":[\"＊ 「うでどけい」 - ぼうぐ DEF1{br}{resetx}{sleep(10)}＊ アンティークかも？ 12じ30ぷんの まえで とまっている\",\"--\"]}},\"item_a_dealmaker\":{\"en\":{\"name\":\"Dealmaker\",\"desc\":[\"Fashionable pink and yellow glasses.\\nGreatly increases $ gained, and...?\",\"--\"],\"reactions\":{\"susie\":\"Money, that's what I need.\",\"ralsei\":\"Two pairs of glasses?\",\"noelle\":\"(Seems... familiar?)\"}},\"ja\":{\"name\":\"ディールメイカー\",\"desc\":[\"ピンクとイエローのオシャレなサングラス。\\n獲得$を大幅にアップ。ほかにも効果が…？\",\"--\"],\"reactions\":{\"susie\":\"カネ オレの ほしいもの\",\"ralsei\":\"サングラスが２つ…？\",\"noelle\":\"(なんか… 見覚えが…？)\"}}},\"item_a_shadowmantle\":{\"en\":{\"name\":\"ShadowMantle\",\"desc\":[\"Shadows slip off like water.\\nGreatly protects against Dark and Star attacks.\",\"--\"],\"effect\":{\"text\":\"Dark/Star\"},\"reactions\":{\"susie\":\"Hell yeah, what's this?\",\"ralsei\":\"Sh-should I wear this...?\",\"noelle\":\"No... it's for someone... taller.\"}},\"ja\":{\"name\":\"シャドウマント\",\"desc\":[\"影を 水のように弾く。\\n闇／星こうげきのダメージを大幅に削減。\",\"--\"],\"effect\":{\"text\":\"闇／星\"},\"reactions\":{\"susie\":\"かっけぇ！ なんだコレ？\",\"ralsei\":\"着ても…いいかな…？\",\"noelle\":\"これは…背の高いひと用…\"}}},\"item_c_lightcandy\":{\"en\":{\"name\":\"LightCandy\",\"desc\":[\"White candy with a chalky texture.\\nIt'll recover 120HP.\",\"Heals 120HP\"],\"reactions\":{\"susie\":\"Hey, this rules!\",\"ralsei\":\"Nice and chalky.\",\"noelle\":\"(I-isn't this the chalk I gave her?)\"}},\"ja\":{\"name\":\"ライトキャンディ\",\"desc\":[\"チョークっぽい食感の白いキャンディ。\\n120HP回復。\",\"120HP\\n回復\"],\"reactions\":{\"susie\":\"こりゃサイコーだな！\",\"ralsei\":\"とってもチョークっぽい味！\",\"noelle\":\"(これって…　スージィにあげたチョーク…？)\"}}},\"item_c_darker_candy\":{\"en\":{\"name\":\"Darker Candy\",\"desc\":[\"A candy that has grown sweeter with time.\\nSaid to taste like toasted marshmallow. +120HP\",\"Heals 120HP\"],\"reactions\":{\"susie\":\"Yeahh!! That's good!\",\"ralsei\":{\"susie\":\"Hey, feed ME!!!\",\"ralsei\":\"Yummy!!! Marshmallows!!\"},\"noelle\":\"Oh, it's... sticky?\"}},\"ja\":{\"name\":\"DDキャンディ\",\"desc\":[\"時間がたって　甘さが増したキャンディ。\\n焼いたマシュマロの味がするらしい。HP+120\",\"120HP\\n回復\"],\"reactions\":{\"susie\":\"うおー！　うんめー！\",\"ralsei\":{\"susie\":\"おい！　オレにも食わせろ！\",\"ralsei\":\"おいしい！　マシュマロだ！\"},\"noelle\":\"ベタベタしてる…？\"}}},\"item_c_top_cake\":{\"en\":{\"name\":\"Top Cake\",\"desc\":[\"This cake will make your taste buds spin! Heals 160HP to the team\",\"Heals team 160HP\"],\"reactions\":{\"susie\":\"Mmm, seconds!\",\"ralsei\":\"Whoops.\",\"noelle\":\"Happy birthday! Haha!\"}},\"ja\":{\"name\":\"トップケーキ\",\"desc\":[\"一口食べれば舌がクルクルおどる絶品ケーキ。\\n仲間全員のHPを160回復。\",\"仲間全員を\\n160HP\\n回復\"],\"reactions\":{\"susie\":\"うま！おかわり！\",\"ralsei\":\"え…\",\"noelle\":\"お誕生日おめでとう！　あはは！\"}}},\"item_c_revivemint\":{\"en\":{\"name\":\"ReviveMint\",\"desc\":[\"Heals a fallen ally to MAX HP.\\nA minty green crystal.\",\"Heals Downed Ally\"],\"reactions\":{\"susie\":{\"susie\":\"I'm ALIVE!!!\",\"ralsei\":\"(You weren't dead)\"},\"ralsei\":{\"susie\":\"(Don't look it)\",\"ralsei\":\"Ah, I'm refreshed!\"},\"noelle\":\"Mints? I love mints!\"}},\"ja\":{\"name\":\"リザレクトミント\",\"desc\":[\"倒れた仲間のHPを全回復。\\n緑色をした　ミントの香りのクリスタル。\",\"倒れた\\n仲間が\\n復活\"],\"reactions\":{\"susie\":{\"susie\":\"生き返ったぜ！\",\"ralsei\":\"(死んでなかったでしょ…)\"},\"ralsei\":{\"susie\":\"(そうは見えねーけどな…)\",\"ralsei\":\"うーん　力がわいてきた！\"},\"noelle\":\"ミント…？　大好き！\"}}},\"item_key_cell_phone\":{\"en\":{\"name\":\"Cell Phone\",\"desc\":[\"It can be used to make calls.\",\"--\"]},\"ja\":{\"name\":\"ケータイ\",\"desc\":[\"電話を　かけられる。\",\"--\"]}},\"item_key_cell_phone_cutscene\":{\"en\":[\"* (You tried to call on the Cell Phone.){stop}\",\"* It's nothing but garbage noise.\"],\"ja\":[\"＊ (ケータイで　発信してみた){stop}\",\"＊ 雑音しか聞こえなかった。\"]},\"spell_act_name\":{\"en\":\"ACT\",\"ja\":\"こうどう\"},\"spell_act_desc\":{\"en\":\"You can do many things.\\nDon't confuse it with magic.\",\"ja\":\"いろんなことをする。\\nまほうではない。\"},\"spell_rude_buster_name\":{\"en\":\"Rude Buster\",\"ja\":\"ルードバスター\"},\"spell_rude_buster_desc\":{\"en\":[\"Deals moderate Rude-elemental damage to one foe. Depends on Attack & Magic.\",\"Rude Damage\"],\"ja\":[\"敵1体に中程度の暴属性ダメージ。\\nこうげきまりょく値によりダメージ量変化。\",\"暴属性\\nダメージ\"]},\"spell_susieheal_name\":{\"en\":[\"UltimateHeal\",\"UltraHeal\",\"OKHeal\",\"BetterHeal\"],\"ja\":[\"ウルティマヒール\",\"ウルトラヒール\",\"OKヒール\",\"ヒール\"]},\"spell_susieheal_desc\":{\"en\":[[\"Heals 1 party member to the best of Susie's ability.\",\"Best Healing\"],[\"An awesome healing spell. ... right?\",\"Best Healing\"],[\"It's not the best healing spell, but it may have its uses.\",\"OK healing\"],[\"A healing spell that has grown with practice and confidence.\",\"Heal Ally\"]],\"ja\":[[\"味方１人を\\nスージィのMAXパワーで回復\",\"最強の\\n回復まほう\"],[\"最強の回復まほう。\\n…のはず？,\",\"最強の\\n回復まほう\"],[\"カンペキな回復まほうではないものの\\nなにか使い道があるかも。\",\"並みの\\n回復\"],[\"練習をつんで自信を得て\\n効果がアップした回復まほう\",\"仲間を\\n回復\"]]},\"spell_pacify_name\":{\"en\":\"Pacify\",\"ja\":\"スリープ\"},\"spell_pacify_desc\":{\"en\":[\"SPARE a tired enemy by putting them to sleep.\",\"Spare TIRED foe\",\"* {0} cast {1}!{br}{resetx}{sleep(10)}* But the enemy wasn't {col(tired_aqua)}TIRED{reset_col}...\"],\"ja\":[\"「くたびれ」状態の敵を眠らせて逃がす。\",\"くたびれた\\n敵を逃がす\",\"＊ {0}は{1}を唱えた！{br}{resetx}{sleep(10)}＊ しかし　敵は{col(tired_aqua)}くたびれて{reset_col}いない…\"]},\"spell_heal_prayer_name\":{\"en\":\"Heal Prayer\",\"ja\":\"いやしの詩\"},\"spell_heal_prayer_desc\":{\"en\":[\"Heavenly Light restores a little HP to\\none party member. Depends on Magic.\",\"Heal Ally\"],\"ja\":[\"天から降り注ぐ光が仲間1人のHPを少量回復。\\nまりょくによって回復量変化。\",\"仲間を\\n回復\"]},\"spell_sleep_mist_name\":{\"en\":\"Sleep Mist\",\"ja\":\"スリープミスト\"},\"spell_sleep_mist_desc\":{\"en\":[\"A cold mist sweeps through, sparing all TIRED enemies.\",\"Spare TIRED foes\"],\"ja\":[\"冷たい霧混じりの風が吹き\\nくたびれた敵を全員逃がす。\",\"くたびれた\\n敵を逃がす\"]},\"spell_iceshock_name\":{\"en\":\"IceShock\",\"ja\":\"アイスショック\"},\"spell_iceshock_desc\":{\"en\":[\"Deal magical ICE damage to one enemy.\",\"Damage w/ ICE\"],\"ja\":[\"氷属性のまほう。\\n敵１体を　こうげきする。\",\"氷属性の\\nこうげき\"]},\"spell_party_action_name\":{\"en\":\"{0}-Action\",\"ja\":\"{0}アクション\"},\"spell_party_action_desc\":{\"en\":\"Standard\",\"ja\":\"標準\"},\"spell_cast\":{\"en\":\"* {0} cast {1}!\",\"ja\":\"＊ {0}は{1}を唱えた！\"},\"item_w_spookysword\":{\"en\":{\"name\":\"Spookysword\",\"desc\":[\"A black-and-orange sword with a bat hilt.\",\"--\"],\"effect\":{\"text\":\"Spookiness UP\"},\"reactions\":{\"susie\":\"Ugh, it's too small!\",\"ralsei\":\"Oh, it's too scary!\",\"noelle\":\"(It's kinda cool...)\"}},\"ja\":{\"name\":\"スケアソード\",\"desc\":[\"柄にコウモリをあしらった\\n黒とオレンジ色のソード。\",\"--\"],\"effect\":{\"text\":\"ブキミさ上昇\"},\"reactions\":{\"susie\":\"ちっこすぎるぜ！\",\"ralsei\":\"ええぇ…怖いよ！\",\"noelle\":\"(ちょっと　かっこいい…)\"}}},\"item_w_lw_halloween_pencil\":{\"en\":{\"name\":\"Halloween Pencil\",\"desc\":[\"* \\\"Halloween Pencil\\\" - Weapon 1 AT{br}{resetx}{s(10)}*Orange with black bats on it.\",\"--\"]},\"ja\":{\"name\":\"ハロウィンエンピツ\",\"desc\":[\"＊ 「ハロウィンエンピツ」 - ぶき　AT1{br}{resetx}{s(10)}＊ オレンジいろの　エンピツ。くろい　コウモリの　もようが　ついている。\",\"--\"]}},\"item_w_wood_blade\":{\"en\":{\"name\":\"Wood Blade\",\"desc\":[\"A wooden practice blade with a carbon-\\nreinforced core.\",\"--\"],\"reactions\":{\"susie\":\"What's this!? A CHOPSTICK?\",\"ralsei\":\"That's yours, Kris...\",\"noelle\":\"(It has bite marks...)\"}},\"ja\":{\"name\":\"木刀\",\"desc\":[\"芯にカーボン素材を用いた練習用の木刀。\",\"--\"],\"reactions\":{\"susie\":\"なんだよこれ！？　わりばしか？\",\"ralsei\":\"クリス…これは　キミのでしょ。\",\"noelle\":\"(かじったあとが　ある…)\"}}},\"item_w_lw_pencil\":{\"en\":{\"name\":\"Pencil\",\"desc\":[\"* \\\"Pencil\\\" - Weapon 1 AT{br}{resetx}{sleep(10)}* Mightier than a sword?{br}{resetx}{sleep(10)} * Maybe equal at best.\",\"--\"]},\"ja\":{\"name\":\"エンピツ\",\"desc\":[\"＊ エンピツ - ぶきAT1{br}{resetx}{sleep(10)}＊ けんより　つよし？{br}{resetx}{sleep(10)}＊ …せいぜい　おなじぐらい　かな。\",\"--\"]}},\"item_w_saber10\":{\"en\":{\"name\":\"Saber10\",\"desc\":[\"A saber made of 10 cactus needles. Fortunately, can deal more than 10 damage.\",\"--\"],\"reactions\":{\"susie\":\"Nah, I'd snap it.\",\"ralsei\":\"You want to... pierce my ears...?\",\"noelle\":\"(I'm not against using it, but...)\"}},\"ja\":{\"name\":\"サーベル10\",\"desc\":[\"サボテンのトゲ10本でできたサーベル。ちゃんと　10以上のダメージを与える。\",\"--\"],\"reactions\":{\"susie\":\"こんなん ヘシ折ってやるよ\",\"ralsei\":\"ボクの耳…刺すの…？\",\"noelle\":\"(使うの イヤじゃない…けど…)\"}}},\"item_w_lw_cactusneedle\":{\"en\":{\"name\":\"CactusNeedle\",\"desc\":[\"* \\\"CactusNeedle\\\" - 2 AT{br}{resetx}{sleep(10)}* Ouch! ... It's somewhat sentimental in a way.\",\"--\"]},\"ja\":{\"name\":\"サボテンのトゲ\",\"desc\":[\"＊ 「サボテンのトゲ」 - ATK+2{br}{resetx}{sleep(10)}＊ イタイ…！　…こころが。\",\"--\"]}},\"item_w_jingleblade\":{\"en\":{\"name\":\"JingleBlade\",\"desc\":[\"A lance-like sword with red-and-white stripes. Perfect for jousting.\",\"--\"],\"effect\":{\"text\":\"Festive\"},\"reactions\":{\"susie\":\"Sleigh the bad guys.\",\"ralsei\":\"Mmm! Minty and festive!\",\"noelle\":\"What is this, a barber pole?\"}},\"ja\":{\"name\":\"ジングルブレード\",\"desc\":[\"ヤリのような剣。赤と白のストライプ模様。\\n馬上ヤリ試合に最適。\",\"--\"],\"effect\":{\"text\":\"ホリデー\"},\"reactions\":{\"susie\":\"モミくちゃにしてやるぜ！\",\"ralsei\":\"ホリデーミント味！\",\"noelle\":\"なにこれ？美容院のサイン？\"}}},\"item_w_lw_holiday_pencil\":{\"en\":{\"name\":\"Holiday Pencil\",\"desc\":[\"* \\\"Holiday Pencil\\\" - 1 AT{br}{resetx}{sleep(10)}* A festive candycane pencil.{br}{resetx}{sleep(10)}* Do not eat.\",\"--\"]},\"ja\":{\"name\":\"ホリデーエンピツ\",\"desc\":[\"＊ 「ホリデーエンピツ」  - ATK+1{br}{resetx}{sleep(10)}＊ キャンディステッキのかたち。{br}{resetx}{sleep(10)}＊ たべられない。\",\"--\"]}},\"item_w_mane_ax\":{\"en\":{\"name\":\"Mane Ax\",\"desc\":[\"Beginner's ax forged from the mane of a dragon whelp.\",\"--\"],\"reactions\":{\"susie\":\"I'm too GOOD for that.\",\"ralsei\":\"Ummm... it's a bit big.\",\"noelle\":\"It... smells nice...\"}},\"ja\":{\"name\":\"ヘアアックス\",\"desc\":[\"子ドラゴンのたてがみで作った\\n初心者用のアックス。\",\"--\"],\"reactions\":{\"susie\":\"こんなのは　もう卒業したぜ\",\"ralsei\":\"ええぇ…ちょっと大きいな…\",\"noelle\":\"ああ…　いいにおい…\"}}},\"item_w_devilsknife\":{\"en\":{\"name\":\"Devilsknife\",\"desc\":[\"Skull-emblazoned scythe-ax.\\nReduces Rudebuster's cost by 10\",\"--\"],\"effect\":{\"text\":\"Buster TP DOWN\"},\"reactions\":{\"susie\":\"Let the games begin!\",\"ralsei\":\"It's too, um, evil.\",\"noelle\":\"...? It smiled at me?\"}},\"ja\":{\"name\":\"デビルズナイフ\",\"desc\":[\"ドクロのマークが刻まれた大ガマのような\\n形状のアックス。ルードバスターのコスト10減。\",\"--\"],\"effect\":{\"text\":\"バスターTPダウン\"},\"reactions\":{\"susie\":\"さあ　ゲームを始めよう！\",\"ralsei\":\"ええぇ…悪モノっぽすぎるよ…\",\"noelle\":\"え…？　笑いかけてきた…？\"}}},\"item_w_absorbax\":{\"en\":{\"name\":\"AbsorbAx\",\"desc\":[\"A long, curved axe with an indent.\\nScoop up HP when you attack.\",\"--\"],\"effect\":{\"text\":\"Vampire\"},\"reactions\":{\"susie\":\"Scoopin' time.\",\"ralsei\":\"Don't scoop me!\",\"noelle\":\"That red... is that blood?\"}},\"ja\":{\"name\":\"スクープアックス\",\"desc\":[\"刻印がほどこされた　長くて曲がったアックス。\\nこうげきすると　HPをすくい取る。\",\"--\"],\"effect\":{\"text\":\"吸血\"},\"reactions\":{\"susie\":\"すくうぜ！\",\"ralsei\":\"ボクは すくわないで！\",\"noelle\":\"赤いのは…血？\"}}},\"item_w_red_scarf\":{\"en\":{\"name\":\"Red Scarf\",\"desc\":[\"A basic scarf made of lightly\\nmagical fiber.\",\"--\"],\"reactions\":{\"susie\":\"No. Just... no.\",\"ralsei\":\"Comfy! Touch it, Kris!\",\"noelle\":\"Huh? No, I'm not cold.\"}},\"ja\":{\"name\":\"レッドマフラー\",\"desc\":[\"わずかに魔力を帯びた毛糸で編んだ\\nシンプルなマフラー。\",\"--\"],\"reactions\":{\"susie\":\"フン…誰が\",\"ralsei\":\"フカフカだ！　触ってみて！\",\"noelle\":\"え… わたし　寒くないよ？\"}}},\"item_w_flexscarf\":{\"en\":{\"name\":\"FlexScarf\",\"desc\":[\"A scarf that is warm and fuzzy, but with\\na metal core that lets it keep its shape.\",\"--\"],\"reactions\":{\"susie\":\"Looks like a giant caterpillar.\",\"ralsei\":\"So pliable, like me!\",\"noelle\":\"Twist it and... it's a wreath!\"}},\"ja\":{\"name\":\"ベンドマフラー\",\"desc\":[\"ほわほわしていてあったかいマフラー。\\n中心に金属の芯が入っていて　形がくずれない。\",\"--\"],\"reactions\":{\"susie\":\"デカいイモムシみてーだな\",\"ralsei\":\"とっても しなやか！\",\"noelle\":\"輪っかにすれば…リースのできあがり！\"}}},\"item_w_puppetscarf\":{\"en\":{\"name\":\"PuppetScarf\",\"desc\":[\"A scarf made of strange strings.\\nFor those that abandon healing.\",\"--\"],\"reactions\":{\"susie\":\"No way, that's creepy.\",\"ralsei\":\"If I have to fight...\",\"noelle\":\"(Feels like guitar strings...)\"}},\"ja\":{\"name\":\"パペットマフラー\",\"desc\":[\"ナゾのヒモでできたマフラー。回復をあきらめる者向け。\",\"--\"],\"reactions\":{\"susie\":\"いや　怪しすぎだろ\",\"ralsei\":\"どうしても戦わなきゃダメなら…\",\"noelle\":\"(ギターの弦みたいな感触…)\"}}},\"item_w_snowring\":{\"en\":{\"name\":\"SnowRing\",\"desc\":[\"A ring with the emblem of the snowflake\",\"--\"],\"reactions\":{\"susie\":\"Smells like Noelle\",\"ralsei\":\"Are you... proposing?\",\"noelle\":\"(Thank goodness...)\"}},\"ja\":{\"name\":\"スノーリング\",\"desc\":[\"雪の結晶のエンブレムがついた指輪。\",\"--\"],\"reactions\":{\"susie\":\"ノエルのにおいがする\",\"ralsei\":\"…プロポーズするの？\",\"noelle\":\"(やっぱり　これが落ち着く…)\"}}},\"item_w_freezering\":{\"en\":{\"name\":\"FreezeRing\",\"desc\":[\"A ring with a snowglobe on it.\\n... is that someone inside?\",\"--\"],\"reactions\":{\"susie\":\"Heh, you steal this? Heh.\",\"ralsei\":\"It's beautiful...\",\"noelle\":\"...\"}},\"ja\":{\"name\":\"凍てつく指輪\",\"desc\":[\"スノードームがついた指輪。\\nなかに　だれかいる…？\",\"--\"],\"reactions\":{\"susie\":\"ヘッ…　盗んだのか？\",\"ralsei\":\"きれい…\",\"noelle\":\"…\"}}},\"menu_label_spr\":{\"en\":\"spr_ui_menu_label\",\"ja\":\"spr_ui_menu_label_ja\"},\"menu_caption_armors_spr\":{\"en\":\"spr_ui_menu_caption_armors\",\"ja\":\"spr_ui_menu_caption_armors_ja\"},\"menu_caption_char_spr\":{\"en\":\"spr_ui_menu_caption_char\",\"ja\":\"spr_ui_menu_caption_char_ja\"},\"menu_caption_equipped_spr\":{\"en\":\"spr_ui_menu_caption_equipped\",\"ja\":\"spr_ui_menu_caption_equipped_ja\"},\"menu_caption_spells_spr\":{\"en\":\"spr_ui_menu_caption_spells\",\"ja\":\"spr_ui_menu_caption_spells_ja\"},\"menu_caption_stats_spr\":{\"en\":\"spr_ui_menu_caption_stats\",\"ja\":\"spr_ui_menu_caption_