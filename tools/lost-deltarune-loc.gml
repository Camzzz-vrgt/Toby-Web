tten.\",\"erase\":\"Choose a file to erase.\",\"erase_warn1\":\"Choose a file to erase.\",\"erase_warn2\":\"Choose a file to erase.\",\"erasesuccess\":\"Erase complete.\",\"eraseempty\":\"There's nothing to erase.\",\"chfile\":\"Start Chapter {0} from Chapter {1}'s FILE.\",\"chfileconfirm\":\"This will start Chapter {0} in FILE Slot {3}.\"},\"ja\":{\"main\":\"ファイルを選んでください。\",\"copy\":\"コピーするファイルを選んでください。\",\"copyto\":\"コピー先のファイルを選んでください。\",\"copyempty\":\"コピーできません。\",\"copycant\":\"そこにはコピーできません。\",\"copysuccess\":\"コピーしました。\",\"copy_overwritewarn\":\"ファイルを上書きします。\",\"erase\":\"消去するファイルを選んでください。\",\"erase_warn1\":\"消去するファイルを選んでください。\",\"erase_warn2\":\"消去するファイルを選んでください。\",\"erasesuccess\":\"消去しました。\",\"eraseempty\":\"消去するものがありません。\",\"chfile\":\"Chapter {1}のファイルで Chapter {0}を始める。\",\"chfileconfirm\":\"スロット{2}で Chapter {0}を始めます。\"}},\"save_select_messages_ominous\":{\"en\":{\"main\":\"\",\"copy\":\"CHOOSE THE ONE TO COPY.\",\"copy_returned\":\"IT RETAINED ITS ORIGINAL SHAPE.\",\"copyto\":\"CHOOSE THE TARGET FOR THE REFLECTION.\",\"copyempty\":\"IT IS BARREN AND CANNOT BE COPIED.\",\"copyempty_all\":\"BUT THERE WAS NOTHING LEFT TO COPY.\",\"copycant\":\"IT IS IMMUNE TO ITS OWN IMAGE.\",\"copysuccess\":\"THE DIVISION IS COMPLETE.\",\"copysuccess_weird\":\"WHAT AN INTERESTING BEHAVIOR.\",\"copysuccess_prepared\":\"PREPARATIONS ARE COMPLETE.\",\"copysuccess_conformed\":\"IT CONFORMED TO THE REFLECTION.\",\"copy_overwritewarn\":\"IT WILL BE SUBSUMED.\",\"erase\":\"SELECT THE ONE TO ERASE.\",\"erase_interesting\":\"VERY INTERESTING.\",\"erase_cancel\":\"THEN IT WAS SPARED.\",\"erase_warn1\":\"TRULY ERASE IT?\",\"erase_warn2\":\"THEN IT WILL BE DESTROYED.\",\"erasesuccess\":\"IT WAS AS IF IT WAS NEVER THERE AT ALL.\",\"eraseempty\":\"BUT IT WAS ALREADY GONE.\",\"eraseempty_all\":\"BUT THERE WAS NOTHING LEFT TO ERASE.\",\"chfile\":\"Start Chapter {0} from Chapter {1}'s FILE.\",\"chfileconfirm\":\"This will start Chapter {0} in FILE Slot {3}.\"},\"ja\":{\"main\":\"\",\"copy\":\"複写元ヲ　選ンデクダサイ。\",\"copy_returned\":\"モトノ　姿ガ　保タレマシタ。\",\"copyto\":\"複写先ヲ　選ンデクダサイ。\",\"copyempty\":\"複写スベキ　モノガ　アリマセン。\",\"copyempty_all\":\"複写スベキ　モノガ　残ッテイマセン。\",\"copycant\":\"同一物ヘノ　複写ハ　不可。\",\"copysuccess\":\"分割　完了。\",\"copysuccess_weird\":\"ジツニ　興味深イ　行動デス。\",\"copysuccess_prepared\":\"準備ハ　完了シマシタ。\",\"copysuccess_conformed\":\"忠実ニ　再現サレマシタ。\",\"copy_overwritewarn\":\"デハ　取リ込ミマス。\",\"erase\":\"消去スルモノヲ　選ンデクダサイ。\",\"erase_interesting\":\"ジツニ　興味深イ。\",\"erase_cancel\":\"消去ハ　免レマシタ。\",\"erase_warn1\":\"本当ニ　消去ヲ？\",\"erase_warn2\":\"デハ　破壊シマス。\",\"erasesuccess\":\"跡形モナク　消エ去リマシタ。\",\"eraseempty\":\"ソレハ　スデニ　存在シマセン。\",\"eraseempty_all\":\"消去スベキ　モノガ　残ッテイマセン。\",\"chfile\":\"Chapter {1}のファイルで Chapter {0}を始める。\",\"chfileconfirm\":\"スロット{3}で Chapter {0}を始めます。\"}},\"save_select_empty\":{\"en\":\"[EMPTY]\",\"ja\":\"[データなし]\"},\"save_select_start\":{\"en\":\"Start\",\"ja\":\"はじめる\"},\"save_select_back\":{\"en\":\"Back\",\"ja\":\"もどる\"},\"save_select_cancel\":{\"en\":\"Cancel\",\"ja\":\"キャンセル\"},\"save_select_copy\":{\"en\":\"Copy\",\"ja\":\"写す\"},\"save_select_erase\":{\"en\":\"Erase\",\"ja\":\"消す\"},\"save_select_chapter_select\":{\"en\":\"Credits\",\"ja\":\"チャプター選択\"},\"save_select_endprogram\":{\"en\":\"End Program\",\"ja\":\"終了\"},\"save_select_continue\":{\"en\":\"Continue\",\"ja\":\"つづき \"},\"save_select_ch_files\":{\"en\":\"Ch {0} Files\",\"ja\":\"Ch{0}ファイル\"},\"save_select_dont_use_file\":{\"en\":\"Don't Use Chapter {0} FILE\",\"ja\":\"Chapter {0}のファイルを使わない\"},\"save_select_yes\":{\"en\":\"Yes\",\"ja\":\"はい\"},\"save_select_no\":{\"en\":\"No\",\"ja\":\"いいえ\"},\"save_select_yes!\":{\"en\":\"Yes!\",\"ja\":\"消す！\"},\"save_select_no!\":{\"en\":\"No!\",\"ja\":\"やめる！\"},\"save_select_completion_file\":{\"en\":[\"Completion FILE not found.\",\"[Made on seeing credits.]\"],\"ja\":[\"クリア済みファイルなし\",\"[条件:クレジットを見る]\"]},\"save_select_copy_query\":{\"en\":\"Copy over this file?\",\"ja\":\"このファイルに上書き？\"},\"save_select_erase_query\":{\"en\":\"Erase this file?\",\"ja\":\"このファイルを消去？\"},\"save_select_erase_query_confirm\":{\"en\":\"Really erase it?\",\"ja\":\"本当に消去？\"},\"txt_debug_loctest\":{\"en\":[\"* (This is a test for the localization system.)\",\"* Susie? Can you enrich my enclosure?\",\"{char(susie)}* Uhh, I can punch a hole in drywall and hide toys inside.\",\"{char(none)}* Thank you. Someday, I will do the same for you...\"],\"ja\":[\"＊ （これはローカライズシステムのテストです。）\",\"＊ スージィ？ ボクさまの飼育環境を改善してくれる？\",\"{char(susie)}＊ あー… カベにコブシで穴あけて 中にオモチャ隠したりとかかな？\",\"{char(none)}＊ ありがとう。いつかボクさまも スージィに 同じことしてあげる…\",\"{break_system(`en`)}* Yeah this is now a different break system, and as such it should use stuff.\"]},\"txt_debug_save_erase\":{\"en\":\"THEN IT WAS{br}SUBSUMED{sleep(10)} BY{br}ETERNAL SHADOW.\",\"ja\":\"そして それは{br}呑まれた{sleep(10)}{br}永劫の闇に。\"},\"txt_shortcut_door\":{\"en\":\"* (It's a door.){br}{resetx}* (Where will you go?)\",\"ja\":\"＊ (とびらだ){br}{resetx}＊ (どこへ行く？)\"},\"txt_shortcut_door_open\":{\"en\":\"* (The door opened...)\",\"ja\":\"＊ (とびらが　開いた…)\"},\"txt_shortcut_door_already\":{\"en\":\"* (Amazingly, you are already there.)\",\"ja\":\"＊ (どういうわけか　もう　そこにいる)\"},\"txt_room_test_zone_entrance\":{\"en\":\"Test Zone - Entrance\",\"ja\":\"テストエリア - エントランス\"},\"txt_room_example_forest\":{\"en\":\"Example Room - Forest\",\"ja\":\"サンプルルーム - 森\"},\"txt_room_example_light\":{\"en\":\"Example Room - Light World\",\"ja\":\"サンプルルーム - 光の世界\"},\"txt_room_example_church_cutscene\":{\"en\":[\"{char(susie, 27)}* ...There's that prophecy again. The one with... us.\",\"{f_ex(31)}* ...\",\"{f_ex(27)}* ...It's... pretty hard to believe.\",\"{f_ex(29)}* Not just... that things have been predicted, sure.\",\"{f_ex(27)}* But that... I'm... part of it too, I guess.\"],\"ja\":[\"{char(susie, 27)}＊ また　予言だな。 オレたちが　出てくるやつ…\",\"{f_ex(31)}＊ …\",\"{f_ex(27)}＊ …やっぱ…信じらんねえよ。\",\"{f_ex(29)}＊ なにが起きるか　わかってるってだけなら　まだ　わかるけど…\",\"{f_ex(27)}＊ そんなかに　オレも　出てくるとかさ。\"]},\"txt_room_example_church_prop1\":{\"en\":\"BUT LO, ON HOPES AND DREAMS THEY SEND.\\nTHREE HEROES AT THE WORLD'S END.\",\"ja\":\"やよ 夢と希望のもと\\nこの世の果てに 送り込まれし３人の勇者\"},\"txt_room_example_church_prop2\":{\"en\":\"THE LIGHT AND DARK, BOTH BURNING DIRE.\\nA COUNTDOWN TO THE EARTH'S EXPIRE.\",\"ja\":\"光も闇も やがて燃え尽きる\\n大地の終焉への秒読み\"},\"txt_room_example_church_prop3\":{\"en\":\"IF FOUNTAINS FREED, THE ROARING CRIES.\\nAND TITANS SHAPE FROM DARKENED EYES.\",\"ja\":\"泉の解き放たれしとき 咆哮は響き\\n暗き瞳より 巨人は現れる\"}}");

function loc_fname_format(arg0)
{
    return "loc/" + arg0;
}

function loc_load(arg0 = global.loc_lang)
{
    var tnms = struct_get_names(global.loc_embedded);
    for (var i = 0; i < array_length(tnms); i++)
    {
        struct_set(global.loc_source, tnms[i], struct_get(struct_get(global.loc_embedded, tnms[i]), arg0));
    }
}

function loc(arg0)
{
    if (struct_exists(global.loc_source, arg0))
    {
        return struct_get(global.loc_source, arg0);
    }
    return arg0;
}

function loc_sprite(arg0)
{
    if (struct_exists(global.loc_source, arg0))
    {
        return asset_get_index(struct_get(global.loc_source, arg0));
    }
    return spr_default;
}

function loc_font(arg0)
{
    return asset_get_index(loc("font_" + arg0));
}

function loc_error(arg0 = "Undefined", arg1 = false)
{
    show_error(string(" \nLOCALIZATION ERROR:\n{0}\n ", arg0), arg1);
}

function loc_getlang()
{
    return global.loc_lang;
}

function loc_switch_lang(arg0 = undefined, arg1 = true)
{
    if (is_undefined(arg0))
    {
        var __langs = ["en", "ja"];
        var __cur = array_get_index(__langs, global.loc_lang);
        global.loc_lang = __langs[(__cur + 1) % array_length(__langs)];
    }
    else
    {
        global.loc_lang = arg0;
    }
    loc_load();
    with (o_world)
    {
        event_user(0);
    }
    if (arg1)
    {
        room_goto(room);
    }
}
